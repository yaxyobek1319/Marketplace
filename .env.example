
# Swagger UI: /api/docs ; OpenAPI: /api/docs-json and /api/docs-yaml
SWAGGER_ENABLED=true
# Documentation-only preview (npm run swagger), without database access:
# SWAGGER_PORT=3002
# SWAGGER_API_URL=http://127.0.0.1:3001

# Local Docker PostgreSQL password; override in the ignored root .env file.
POSTGRES_PASSWORD=marketplace
