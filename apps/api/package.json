{
  "name": "@marketplace/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ignore src/openapi/document.ts --ext ts,env --exec \"npm run build && node dist/main.js\"",
    "build": "tsc && node ../../scripts/generate-openapi.cjs && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:seed": "tsx prisma/seed.ts",
    "staff:provision": "tsx scripts/provision-staff.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"prisma/seed.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"prisma/seed.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.61.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.0",
    "ioredis": "^5.8.1",
    "otplib": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@nestjs/testing": "^10.4.22",
    "@types/node": "^22.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "zod-to-json-schema": "^3.25.0"
  }
}
