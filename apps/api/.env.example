DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public"
PORT=3001
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=local-development-key-change-before-deploy
# Set to true only after Postgres migrations, Redis, Meilisearch and adapters are configured.
RUN_WORKERS=false
# Generate 32 random bytes as 64 hex characters. Required for staff TOTP storage.
SECRET_ENCRYPTION_KEY=
# Static prices in UZS. A single charge per seller group, as described in docs/DECISIONS.md.
DELIVERY_EXPRESS_AMOUNT=
DELIVERY_STANDARD_AMOUNT=
# TZ leaves these durations unspecified: choose explicitly before enabling these flows.
AUTO_CONFIRM_HOURS=
DISPUTE_RESPONSE_HOURS=
# Name of a registered adapter (BTS, FARGO, YANDEX_DELIVERY).
DELIVERY_PROVIDER=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Public product images only; mount persistent storage in production.
PUBLIC_API_BASE_URL=http://localhost:3001
UPLOAD_DIR=uploads/products

# Swagger UI /api/docs; DBsiz ko‘rish: npm run swagger
SWAGGER_ENABLED=true
